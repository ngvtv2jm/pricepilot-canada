VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Never expose service-role credentials in VITE_ variables.
# Public canonical origin; keep build and runtime metadata consistent.
VITE_SITE_URL=https://pricepine.ca
# Optional public ownership identifiers. These do not activate ads.
GOOGLE_SITE_VERIFICATION=
# Overrides the public PricePine verification meta tag only.
ADSENSE_VERIFICATION_ACCOUNT=
# Leave blank unless enabling a Google seller record in ads.txt.
ADSENSE_PUBLISHER_ID=
